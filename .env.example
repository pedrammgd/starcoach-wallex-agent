GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash

SSL_CERT_FILE=/etc/ssl/cert.pem

# Read-only competition access and explicit Liara target
WALLEX_API_KEY=YOUR_WALLEX_COMPETITION_READ_ONLY_API_KEY_HERE
WALLEX_ACCOUNT_SCOPE=competition_credit
WALLEX_CREDIT_ACCOUNT_ID=
WALLEX_READ_ONLY=true
WALLEX_PRIVATE_READS_ENABLED=false
WALLEX_ENABLE_WITHDRAWALS=false
WALLEX_ENABLE_TRANSFERS=false
LIARA_ACCOUNT=
LIARA_TEAM_ID=
LIARA_APP_NAME=
LIARA_RUNTIME_REGION=unverified
LLM_PROVIDER=boxapi
TRADING_MODE=shadow
ENABLE_LIVE_TRADING=false
BOXAPI_API_KEY=YOUR_BOXAPI_API_KEY_HERE
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
BOXAPI_MODEL=openai/gpt-5.4-mini
BOXAPI_TIMEOUT_SECONDS=20
